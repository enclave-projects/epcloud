# Copy to `.env` next to this file, then run:
#   supabase secrets set --env-file supabase/functions/send-email/.env
#
# Use the value provided when you create the Send Email Hook in the Supabase
# dashboard (Auth → Hooks). Paste the full "v1,whsec_..." value as-is — the
# function strips the prefix automatically.

RESEND_API_KEY=re_xxx
SENDER_EMAIL=ep-cloud@enclaveprojects.dev
SEND_EMAIL_HOOK_SECRET=v1,whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
